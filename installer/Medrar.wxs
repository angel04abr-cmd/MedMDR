<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI de Medrar (WiX Toolset). Se compila con:
    .tools\wix.exe build installer\Medrar.wxs -arch x64 -d Version=1.2.0 -d Source=dist\Medrar -ext WixToolset.UI.wixext -culture es-ES -o dist\Medrar-1.2.0-x64.msi
  (build.ps1 -Installer lo hace solo). Por defecto se instala SOLO PARA EL USUARIO (sin permisos de administrador), en
  %LocalAppData%\Programs\Medrar, lo que permite que las actualizaciones automáticas se instalen sin pedir elevación.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Package Name="Medrar" Manufacturer="Medrar" Version="$(Version)" UpgradeCode="7B2D1A44-9E3C-4F6B-8A51-2C9D0E5F7A13"
           Scope="perUser" Language="1034" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Gestor de archivos comprimidos" Manufacturer="Medrar" />

    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más nueva de Medrar instalada." />

    <!-- Medrar necesita el .NET 10 Desktop Runtime (x64). DOTNET10 vale 0 cuando hay uno compatible. -->
    <netfx:DotNetCompatibilityCheck Id="CompruebaDotNet10" Property="DOTNET10" RollForward="latestMinor" RuntimeType="desktop" Platform="x64" Version="10.0.0" />
    <Launch Condition="Installed OR DOTNET10=&quot;0&quot;"
            Message="Medrar necesita el .NET 10 Desktop Runtime (x64), que no está instalado. Descárgalo desde https://dotnet.microsoft.com/download/dotnet/10.0 (Desktop Runtime) e instálalo; después vuelve a ejecutar este instalador." />

    <!-- El instalador antiguo (.exe, Inno Setup) deja claves en HKLM que anulan las del usuario: hay que quitarlo antes. -->
    <?ifndef SkipInnoCheck?>
    <Property Id="INNO_ANTIGUO_64">
      <RegistrySearch Id="BuscaInno64" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{8C3F1B8E-5D3A-4C2E-9B6A-4F0E7B2A91D5}_is1" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INNO_ANTIGUO_32">
      <RegistrySearch Id="BuscaInno32" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{8C3F1B8E-5D3A-4C2E-9B6A-4F0E7B2A91D5}_is1" Name="UninstallString" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="INNO_ANTIGUO_USR">
      <RegistrySearch Id="BuscaInnoUsr" Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{8C3F1B8E-5D3A-4C2E-9B6A-4F0E7B2A91D5}_is1" Name="UninstallString" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (NOT INNO_ANTIGUO_64 AND NOT INNO_ANTIGUO_32 AND NOT INNO_ANTIGUO_USR)"
            Message="Hay una versión anterior de Medrar instalada con el instalador .exe. Desinstálala primero (Configuración de Windows, Aplicaciones, Medrar) y vuelve a ejecutar este instalador. Tus archivos y tu configuración no se borran." />
    <?endif?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MedrarIcon" SourceFile="src\Medrar\Resources\medrar.ico" />
    <Property Id="ARPPRODUCTICON" Value="MedrarIcon" />
    <Property Id="ARPCOMMENTS" Value="Gestor de archivos comprimidos" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\Aviso.rtf" />

    <Feature Id="Main" Title="Medrar" Description="El programa, la línea de comandos (mdr.exe) y los módulos autoextraíbles." Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="Programa" />
      <Feature Id="Asociacion" Title="Asociar los archivos .mdr" Description="Los archivos .mdr se abrirán con Medrar (doble clic)." Level="1">
        <ComponentRef Id="AsociacionMdr" />
      </Feature>
      <Feature Id="MenuContextual" Title="Menú del botón derecho" Description="Añade «Añadir a un archivo con Medrar» al menú del Explorador." Level="1">
        <ComponentRef Id="MenuContextualReg" />
      </Feature>
      <Feature Id="Escritorio" Title="Acceso directo en el escritorio" Description="Crea un icono de Medrar en el escritorio." Level="1000">
        <ComponentRef Id="AccesoEscritorio" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Medrar" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Programa" Directory="INSTALLFOLDER">
      <Component Id="MedrarExe" Guid="*">
        <File Id="MedrarExeFile" Source="$(Source)\Medrar.exe" KeyPath="yes" />
        <Shortcut Id="AccesoInicio" Directory="ProgramMenuFolder" Name="Medrar" Description="Gestor de archivos comprimidos"
                  WorkingDirectory="INSTALLFOLDER" Icon="MedrarIcon" Advertise="no" />
        <!-- Marca que la app lee para saber que está instalada con el MSI (y puede actualizarse sola) -->
        <RegistryValue Root="HKCU" Key="Software\Medrar" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Root="HKCU" Key="Software\Medrar" Name="Installer" Type="string" Value="msi" />
        <RemoveFolder Id="QuitarProgramsDir" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="MdrExe" Guid="*">
        <File Source="$(Source)\mdr.exe" KeyPath="yes" />
      </Component>
      <Component Id="SfxLigero" Guid="*">
        <File Source="$(Source)\Medrar.Sfx.exe" KeyPath="yes" />
      </Component>
      <Component Id="SfxCompleto" Guid="*">
        <File Source="$(Source)\Medrar.Sfx.Full.exe" KeyPath="yes" />
      </Component>
      <Component Id="Docs" Guid="*">
        <File Source="$(Source)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="Avisos" Guid="*">
        <File Source="$(Source)\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="AccesoEscritorio" Directory="INSTALLFOLDER" Guid="*">
      <Shortcut Id="AccesoEscritorioLnk" Directory="DesktopFolder" Name="Medrar" Description="Gestor de archivos comprimidos"
                Target="[INSTALLFOLDER]Medrar.exe" WorkingDirectory="INSTALLFOLDER" Icon="MedrarIcon" Advertise="no" />
      <RegistryValue Root="HKCU" Key="Software\Medrar" Name="Escritorio" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Asociación de .mdr y sus órdenes en el menú contextual del archivo -->
    <Component Id="AsociacionMdr" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\.mdr" Type="string" Value="Medrar.Archive" KeyPath="yes" />
      <RegistryKey Root="HKCU" Key="Software\Classes\Medrar.Archive">
        <RegistryValue Type="string" Value="Archivo Medrar" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
        <RegistryValue Key="shell\open" Type="string" Value="Abrir con Medrar" />
        <RegistryValue Key="shell\open" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; &quot;%1&quot;" />
        <RegistryValue Key="shell\extracthere" Type="string" Value="Extraer aquí" />
        <RegistryValue Key="shell\extracthere" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
        <RegistryValue Key="shell\extracthere\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; --extract-here &quot;%1&quot;" />
        <RegistryValue Key="shell\extractto" Type="string" Value="Extraer en una carpeta…" />
        <RegistryValue Key="shell\extractto" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
        <RegistryValue Key="shell\extractto\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; --extract-to &quot;%1&quot;" />
        <RegistryValue Key="shell\test" Type="string" Value="Comprobar el archivo" />
        <RegistryValue Key="shell\test" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
        <RegistryValue Key="shell\test\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; --test &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <!-- «Añadir a un archivo con Medrar» en el menú del botón derecho -->
    <Component Id="MenuContextualReg" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\Medrar.Add" Type="string" Value="Añadir a un archivo con Medrar…" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\Medrar.Add" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
      <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\Medrar.Add\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; --add &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Medrar.Add" Type="string" Value="Añadir a un archivo con Medrar…" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Medrar.Add" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Medrar.Add\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; --add &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Medrar.Open" Type="string" Value="Abrir esta carpeta en Medrar" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Medrar.Open" Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot;,0" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Medrar.Open\command" Type="string" Value="&quot;[INSTALLFOLDER]Medrar.exe&quot; &quot;%V&quot;" />
    </Component>
  </Fragment>
</Wix>


