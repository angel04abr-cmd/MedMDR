<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MedMDR.Wpf</RootNamespace>
    <AssemblyName>MedMDR</AssemblyName>
    <Version>2.0.3</Version>
    <ApplicationIcon>Resources\medmdr.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- El tema Fluent integrado de WPF (ThemeMode) aún está marcado como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\medmdr.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedMDR.Core\MedMDR.Core.csproj" />
  </ItemGroup>

</Project>
