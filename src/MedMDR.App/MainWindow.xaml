<Window x:Class="MedMDR.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedMDR.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MedMDR" Width="1180" Height="720" MinWidth="860" MinHeight="480"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:HeaderTitleConverter x:Key="HeaderTitle" />
    </Window.Resources>

    <!-- Barra de título propia: el encabezado (menús y botones) ocupa el sitio de la barra de Windows; los botones de ventana son los nativos -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="True" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fila 1 del encabezado: icono, menús, título discreto y, a la derecha, el sitio de los botones nativos de ventana -->
        <Grid Grid.Row="0" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="150" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" Margin="14,0,6,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Menu x:Name="MainMenu" Grid.Column="1" Background="Transparent" Padding="2,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Los menús de arriba, en versión compacta: el estilo de Fluent reserva ~48 px de alto y no cabe en la fila del encabezado -->
                <Menu.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Border" Margin="1,3" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <Grid>
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="10,5" VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="4"
                                                   PopupAnimation="None" AllowsTransparency="True" Focusable="False">
                                                <Border BorderThickness="1" Padding="0,3" CornerRadius="8" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                                        Background="{DynamicResource FlyoutBackground}" Margin="12,0,12,18" SnapsToDevicePixels="True">
                                                    <Border.Effect><DropShadowEffect ShadowDepth="6" Direction="270" Opacity="0.25" BlurRadius="20" /></Border.Effect>
                                                    <ScrollViewer CanContentScroll="True" Style="{DynamicResource MenuItemScrollViewerStyle}">
                                                        <Grid>
                                                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"
                                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                        </Grid>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                        </Trigger>
                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        </Trigger>
                        </Style.Triggers>
                    </Style>
                </Menu.ItemContainerStyle>
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir archivo…" InputGestureText="Ctrl+O" Click="OpenArchiveDialog_Click" />
                <MenuItem Header="Abrir _carpeta…" Click="OpenFolder_Click" />
                <MenuItem Header="_Subir un nivel" InputGestureText="Retroceso" Click="Up_Click" />
                <MenuItem x:Name="MenuClose" Header="C_errar el archivo" Click="CloseArchive_Click" />
                <Separator />
                <MenuItem Header="Contraseña para esta _sesión…" InputGestureText="Ctrl+P" Click="SessionPassword_Click" />
                <Separator />
                <MenuItem Header="Se_leccionar todo" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <MenuItem Header="Co_piar los nombres" Click="CopyNames_Click" />
                <Separator />
                <MenuItem Header="_Salir" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Órdenes">
                <MenuItem Header="_Añadir ficheros al archivo…" InputGestureText="Alt+A" Click="Command_Add" />
                <MenuItem Header="_Extraer en…" InputGestureText="Alt+E" Click="Command_Extract" />
                <MenuItem Header="Extraer a_quí" Click="Command_ExtractHere" />
                <MenuItem Header="_Comprobar" InputGestureText="Alt+T" Click="Command_Test" />
                <Separator />
                <MenuItem Header="_Ver el fichero" InputGestureText="Alt+V" Click="Command_View" />
                <MenuItem Header="E_liminar" InputGestureText="Supr" Click="Command_Delete" />
                <MenuItem Header="_Renombrar" InputGestureText="F2" Click="Command_Rename" />
                <Separator />
                <MenuItem Header="Agregar co_mentario…" InputGestureText="Alt+M" Click="Command_Comment" />
                <MenuItem Header="_Proteger contra daños…" InputGestureText="Alt+P" Click="Command_Protect" />
                <MenuItem Header="_Bloquear / desbloquear" InputGestureText="Alt+L" Click="Command_Lock" />
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Información" InputGestureText="Alt+I" Click="Command_Info" />
                <MenuItem Header="_Informe del archivo…" Click="Command_Report" />
                <MenuItem Header="_Reparar archivo…" InputGestureText="Alt+R" Click="Command_Repair" />
                <Separator />
                <MenuItem Header="Convertir en autoe_xtraíble…" InputGestureText="Alt+X" Click="Command_Sfx" />
                <MenuItem Header="_Quitar el módulo autoextraíble…" Click="Command_UnpackSfx" />
                <Separator />
                <MenuItem Header="_Asistente…" Click="Command_Wizard" />
                <MenuItem Header="Convertir _archivos…" InputGestureText="Alt+Q" Click="Command_Convert" />
                <MenuItem Header="_Buscar ficheros…" InputGestureText="F3" Click="Command_Find" />
                <MenuItem Header="_Prueba de velocidad…" InputGestureText="Alt+B" Click="Benchmark_Click" />
            </MenuItem>
            <MenuItem Header="Fa_voritos">
                <MenuItem Header="_Añadir la ubicación actual a favoritos" Click="AddFavorite_Click" />
                <MenuItem Header="_Quitar de favoritos…" Click="RemoveFavorite_Click" />
            </MenuItem>
            <MenuItem Header="O_pciones">
                <MenuItem Header="_Tema">
                    <MenuItem x:Name="ThemeSystem" Header="Predeterminado del sistema" IsCheckable="True" Tag="System" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeLight" Header="Claro" IsCheckable="True" Tag="Light" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeDark" Header="Oscuro" IsCheckable="True" Tag="Dark" Click="Theme_Click" />
                </MenuItem>
                <MenuItem Header="_Configuración…" Click="Command_Settings" />
                <Separator />
                <MenuItem Header="_Exportar la configuración…" Click="ExportSettings_Click" />
                <MenuItem Header="_Importar la configuración…" Click="ImportSettings_Click" />
                <MenuItem Header="_Restablecer la configuración…" Click="ResetSettings_Click" />
            </MenuItem>
            <MenuItem Header="Ay_uda">
                <MenuItem Header="Buscar a_ctualizaciones…" Click="CheckUpdates_Click" />
                <Separator />
                <MenuItem Header="_Acerca de MedMDR…" Click="About_Click" />
            </MenuItem>
            </Menu>
            <TextBlock Grid.Column="2" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HeaderTitle}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Fila 2 del encabezado: barra de comandos (mismo fondo, sin líneas) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,2">
            <local:CommandButton x:Name="CmdAdd" Kind="Add" Label="Añadir" Click="Command_Add" />
            <local:CommandButton x:Name="CmdExtract" Kind="Extract" Label="Extraer en" Click="Command_Extract" />
            <local:CommandButton x:Name="CmdTest" Kind="Test" Label="Comprobar" Click="Command_Test" />
            <local:CommandButton x:Name="CmdView" Kind="View" Label="Ver" Click="Command_View" />
            <local:CommandButton x:Name="CmdDelete" Kind="Delete" Label="Eliminar" Click="Command_Delete" />
            <local:CommandButton x:Name="CmdFind" Kind="Find" Label="Buscar" Click="Command_Find" />
            <local:CommandButton x:Name="CmdWizard" Kind="Wizard" Label="Asistente" Click="Command_Wizard" />
            <local:CommandButton x:Name="CmdInfo" Kind="Info" Label="Información" Click="Command_Info" />
            <Rectangle Width="1" Margin="8,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <local:CommandButton x:Name="CmdRepair" Kind="Repair" Label="Reparar" Click="Command_Repair" />
        </StackPanel>

        <!-- Barra de direcciones -->
        <Grid Grid.Row="2" Margin="12,6,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" AutomationProperties.Name="Subir un nivel" Grid.Column="0" Width="38" Height="34" Padding="0" Margin="0,0,8,0" ToolTip="Subir un nivel (Retroceso)" Click="Up_Click">
                <local:Icon Kind="Up" Size="18" />
            </Button>
            <TextBox x:Name="AddressBox" AutomationProperties.Name="Ruta actual" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="10,0" KeyDown="AddressBox_KeyDown" />
        </Grid>

        <!-- Panel lateral + contenido -->
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="224" MinWidth="150" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Sidebar" AutomationProperties.Name="Accesos, favoritos y recientes" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="Sidebar_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="10,12,0,4" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Kind="{Binding Kind}" Size="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Quitar de favoritos" Click="SidebarRemoveFavorite_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Comentario del archivo (solo si lo tiene) -->
                <Border x:Name="CommentBar" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,8" Padding="14,10" CornerRadius="{StaticResource RadiusCard}"
                        BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <TextBlock x:Name="CommentText" TextWrapping="Wrap" MaxHeight="90" />
                </Border>
                <Border Grid.Row="1" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <ListView x:Name="FileList" AutomationProperties.Name="Lista de ficheros" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource FileRowStyle}" Margin="2,4,2,4"
                              MouseDoubleClick="FileList_MouseDoubleClick" SelectionChanged="FileList_SelectionChanged"
                              GridViewColumnHeader.Click="Header_Click" SizeChanged="FileList_SizeChanged" ContextMenuOpening="FileList_ContextMenuOpening"
                              PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp" PreviewMouseMove="FileList_PreviewMouseMove">
                        <ListView.ContextMenu>
                            <ContextMenu x:Name="RowMenu" />
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView x:Name="Columns" AllowsColumnReorder="False">
                                <GridViewColumn Header="Nombre" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="22" Height="22" Margin="2,0,10,0">
                                                    <local:Icon Kind="{Binding VectorIcon, TargetNullValue=Info}" Size="22"
                                                                Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}" />
                                                    <Image Source="{Binding ShellIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasShellIcon, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tamaño" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Comprimido" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PackedText}" TextAlignment="Right" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tipo" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Modificado" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CRC32" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CrcText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra de estado -->
        <Grid Grid.Row="4" Margin="16,2,16,8">
            <TextBlock x:Name="StatusLeft" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
