<Window x:Class="MedMDR.Wpf.ExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carpeta y opciones de extracción" Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <StackPanel Margin="28,22,28,20">
        <TextBlock Text="Carpeta de destino (si no existe, se creará):" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Dest" IsEditable="True" Height="34" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="Browse_Click" />
            <Button Grid.Column="2" Content="Nueva carpeta…" Margin="8,0,0,0" Padding="14,7" Click="NewFolder_Click" />
        </Grid>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Modo de actualización" Style="{StaticResource SectionTitle}" />
                <RadioButton x:Name="UReplace" Content="Extraer y reemplazar ficheros" GroupName="u" IsChecked="True" />
                <RadioButton x:Name="UUpdate" Content="Extraer y actualizar ficheros" GroupName="u" />
                <RadioButton x:Name="UFresh" Content="Solo actualizar los ya existentes" GroupName="u" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Modo de sobrescritura" Style="{StaticResource SectionTitle}" />
                <RadioButton x:Name="OAsk" Content="Confirmar la sobrescritura" GroupName="o" />
                <RadioButton x:Name="OYes" Content="Sobrescribir sin confirmación" GroupName="o" />
                <RadioButton x:Name="OSkip" Content="Omitir los ficheros existentes" GroupName="o" />
                <RadioButton x:Name="ORename" Content="Renombrar automáticamente" GroupName="o" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Rutas" Style="{StaticResource SectionTitle}" />
        <RadioButton x:Name="PFull" Content="Extraer con las rutas completas" GroupName="p" IsChecked="True" />
        <RadioButton x:Name="PNone" Content="Extraer sin rutas (todo en una carpeta)" GroupName="p" />

        <TextBlock Text="Varios" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="Sub" Content="Crear una carpeta con el nombre del archivo" />
        <CheckBox x:Name="Broken" Content="Conservar los ficheros dañados" />
        <CheckBox x:Name="ShowExplorer" Content="Mostrar los ficheros en el Explorador" />

        <Grid Margin="0,22,0,0">
            <Button Content="Guardar opciones" HorizontalAlignment="Left" Padding="14,7" Click="Save_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aceptar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="96" Padding="16,7" Click="Ok_Click" />
                <Button Content="Cancelar" IsCancel="True" MinWidth="96" Padding="16,7" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
