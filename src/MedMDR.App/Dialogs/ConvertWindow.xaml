<Window x:Class="MedMDR.Wpf.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convertir archivos" Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <StackPanel Margin="28,22,28,20">
        <TextBlock Text="Archivos que se convertirán:" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Files" Height="116" SelectionMode="Extended" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Añadir…" Padding="14,7" MinWidth="92" Click="Add_Click" />
                <Button Content="Quitar" Padding="14,7" Margin="0,8,0,0" Click="Remove_Click" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Convertir a:" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="FormatBox" Height="32" SelectionChanged="Format_Changed" />
        <TextBlock Text="Nivel de compresión:" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="LevelBox" Height="32" />

        <CheckBox x:Name="SolidCheck" Content="Crear archivos sólidos" Margin="0,16,0,0" />
        <CheckBox x:Name="RecCheck" Content="Añadir registro de recuperación (5 %; en .mdr dentro, en los demás en un fichero .mdrrec)" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="PwButton" Content="Contraseña…" Padding="14,7" Click="Password_Click" />
            <TextBlock x:Name="PwState" Text="Sin contraseña" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock Text="Carpeta de destino:" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DestBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
            <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="Browse_Click" />
        </Grid>
        <CheckBox x:Name="DeleteCheck" Content="Eliminar los archivos originales al terminar" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Convertir" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="104" Padding="16,7" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="104" Padding="16,7" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
