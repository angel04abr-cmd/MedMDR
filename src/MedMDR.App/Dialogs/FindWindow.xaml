<Window x:Class="MedMDR.Wpf.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar ficheros" Width="740" Height="640" MinWidth="620" MinHeight="520" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Where" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Texto a buscar:" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
            <TextBlock Text="Nombres de fichero (comodines, separados por ;):" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MaskBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="*" />
            <WrapPanel Margin="0,12,0,0">
                <CheckBox x:Name="CaseCheck" Content="Distinguir mayúsculas" Margin="0,0,24,6" />
                <CheckBox x:Name="HexCheck" Content="Buscar bytes en hexadecimal (ej. 4D 5A)" Margin="0,0,24,6" />
            </WrapPanel>
            <WrapPanel x:Name="FolderOptions">
                <CheckBox x:Name="SubCheck" Content="Incluir subcarpetas" IsChecked="True" Margin="0,0,24,6" />
                <CheckBox x:Name="InsideCheck" Content="Buscar dentro de los archivos comprimidos" IsChecked="True" Margin="0,0,24,6" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                <Button x:Name="GoButton" Content="Buscar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="96" Padding="16,7" Click="Go_Click" />
                <Button x:Name="StopButton" Content="Detener" MinWidth="96" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="1" MouseDoubleClick="Results_DoubleClick" ItemContainerStyle="{StaticResource FileRowStyle}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Dónde" Width="300" DisplayMemberBinding="{Binding Item}" />
                    <GridViewColumn Header="Coincidencia" Width="340" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Text="Haz doble clic en un resultado para ir a él." Style="{StaticResource Hint}" Margin="0,10,0,0" />
    </Grid>
</Window>
