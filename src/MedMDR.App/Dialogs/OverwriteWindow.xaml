<Window x:Class="MedMDR.Wpf.OverwriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedMDR.Wpf"
        Title="El fichero ya existe" Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Ya existe este fichero en la carpeta de destino:" />
        <TextBlock x:Name="PathText" Grid.Row="1" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="InfoText" Grid.Row="2" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <CheckBox x:Name="ApplyAll" Grid.Row="3" Margin="0,16,0,0" Content="Aplicar a todos los ficheros siguientes" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Sobrescribir" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Padding="16,7" Click="Overwrite_Click" />
            <Button Content="Omitir" Padding="16,7" Margin="8,0,0,0" Click="Skip_Click" />
            <Button Content="Renombrar" Padding="16,7" Margin="8,0,0,0" Click="Rename_Click" />
            <Button Content="Cancelar" IsCancel="True" Padding="16,7" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
