<Window x:Class="MedMDR.Wpf.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nombre y parámetros del archivo" Width="800" Height="720" MinWidth="720" MinHeight="520" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="20,16,20,0" Padding="0">
            <!-- ================= General ================= -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,6,16,12">
                        <TextBlock Text="Nombre del archivo:" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="NameBox" IsEditable="True" Height="34" VerticalContentAlignment="Center" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="Browse_Click" />
                            <Button Grid.Column="2" Content="Perfiles…" Margin="8,0,0,0" Padding="14,7" Click="Profiles_Click" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Modo de actualización:" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ModeBox" Height="32" />

                                <TextBlock Text="Formato:" Style="{StaticResource FieldLabel}" />
                                <RadioButton x:Name="FMdr" GroupName="fmt" Content="MedMDR (.mdr) — cifrado, recuperación y más" Checked="Format_Changed" />
                                <WrapPanel Margin="0,2,0,0">
                                    <RadioButton x:Name="FZip" GroupName="fmt" Content="ZIP" Margin="0,0,16,0" Checked="Format_Changed" />
                                    <RadioButton x:Name="F7z" GroupName="fmt" Content="7Z" Margin="0,0,16,0" Checked="Format_Changed" />
                                    <RadioButton x:Name="FTgz" GroupName="fmt" Content="TAR.GZ" Margin="0,0,16,0" Checked="Format_Changed" />
                                    <RadioButton x:Name="FTar" GroupName="fmt" Content="TAR" Margin="0,0,16,0" Checked="Format_Changed" />
                                    <RadioButton x:Name="FGz" GroupName="fmt" Content="GZ (1 fichero)" Checked="Format_Changed" />
                                </WrapPanel>
                                <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,8,0,0" MinHeight="36" />

                                <TextBlock Text="Método de compresión:" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LevelBox" Height="32" />
                                <TextBlock Text="Tamaño del diccionario:" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DictBox" Height="32" />
                                <TextBlock Text="Dividir en volúmenes de:" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="VolBox" Width="90" Height="32" VerticalContentAlignment="Center" />
                                    <ComboBox x:Name="VolUnit" Width="80" Height="32" Margin="8,0,0,0" />
                                    <TextBlock Text="(vacío = un solo fichero)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Opciones" Style="{StaticResource FieldLabel}" />
                                <CheckBox x:Name="DeleteCheck" Content="Eliminar los ficheros originales al terminar" Margin="0,3" />
                                <CheckBox x:Name="SfxCheck" Content="Crear archivo autoextraíble (.exe)" Margin="0,3" Checked="Format_Changed" Unchecked="Format_Changed" />
                                <CheckBox x:Name="SfxFullCheck" Content="Incluir .NET (sin nada instalado; pesa más)" Margin="22,3,0,3" />
                                <CheckBox x:Name="SolidCheck" Content="Crear archivo sólido" Margin="0,3" />
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox x:Name="RecCheck" Content="Añadir registro de recuperación" VerticalAlignment="Center" Checked="Format_Changed" Unchecked="Format_Changed" />
                                    <TextBox x:Name="RecPct" Width="48" Height="28" Margin="8,0,4,0" Text="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="%" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox x:Name="TestCheck" Content="Verificar los ficheros comprimidos" Margin="0,3" />
                                <CheckBox x:Name="LockCheck" Content="Bloquear el archivo (impide modificarlo)" Margin="0,3" />

                                <Button x:Name="PwButton" Content="Establecer contraseña…" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7" Click="Password_Click" />
                                <TextBlock x:Name="PwState" Text="Sin contraseña" Style="{StaticResource Hint}" Margin="2,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Avanzado ================= -->
            <TabItem Header="Avanzado">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,6,16,12">
                        <TextBlock Text="Compresión" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="DeflateCheck" Content="Usar Deflate en lugar de Brotli (más compatible, menos compresión)" />
                        <TextBlock Text="Rutas dentro del archivo" Style="{StaticResource SectionTitle}" />
                        <RadioButton x:Name="PRel" GroupName="path" Content="Rutas relativas (la carpeta y su contenido)" IsChecked="True" Margin="0,3" />
                        <RadioButton x:Name="PFull" GroupName="path" Content="Rutas completas (sin la letra de unidad)" Margin="0,3" />
                        <RadioButton x:Name="PNone" GroupName="path" Content="Sin rutas (solo los nombres de fichero)" Margin="0,3" />
                        <TextBlock Text="Guardar sin comprimir (comodines separados por ; )" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="StoreBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6" />
                        <TextBlock Text="Excluir del archivo (comodines separados por ; )" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="ExcludeBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Comentario ================= -->
            <TabItem Header="Comentario">
                <Grid Margin="16,6,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Texto que se guardará dentro del archivo:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CommentBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6" VerticalContentAlignment="Top" />
                    <Button Grid.Row="2" Content="Cargar desde un fichero…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,7" Click="LoadComment_Click" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,18">
            <Button Content="Aceptar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="104" Padding="16,7" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="104" Padding="16,7" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
