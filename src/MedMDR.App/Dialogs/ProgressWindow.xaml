<Window x:Class="MedMDR.Wpf.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedMDR" Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="FileText" Grid.Row="1" Margin="0,10,0,10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="6" Minimum="0" Maximum="1000" />
        <TextBlock x:Name="StatsText" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" MinHeight="34" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BackgroundButton" Content="En segundo plano" Padding="16,7" Margin="0,0,8,0" Click="Background_Click" />
            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96" Padding="16,7" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
