<Window x:Class="MedMDR.Wpf.NewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Establecer contraseña" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="Escribe la contraseña del archivo:" />
        <Grid Margin="0,10,0,0">
            <PasswordBox x:Name="Pw" Height="34" VerticalContentAlignment="Center" Padding="10,0" />
            <TextBox x:Name="PwText" Height="34" VerticalContentAlignment="Center" Padding="10,0" Visibility="Collapsed" />
        </Grid>
        <TextBlock Text="Repite la contraseña para comprobarla:" Style="{StaticResource FieldLabel}" />
        <Grid>
            <PasswordBox x:Name="Pw2" Height="34" VerticalContentAlignment="Center" Padding="10,0" />
            <TextBox x:Name="Pw2Text" Height="34" VerticalContentAlignment="Center" Padding="10,0" Visibility="Collapsed" />
        </Grid>
        <CheckBox x:Name="ShowPw" Content="Mostrar la contraseña" Margin="0,14,0,0" Checked="Show_Changed" Unchecked="Show_Changed" />
        <CheckBox x:Name="Names" Content="Cifrar también los nombres de los ficheros" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Aceptar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="96" Padding="16,7" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="96" Padding="16,7" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
