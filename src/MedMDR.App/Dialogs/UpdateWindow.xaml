<Window x:Class="MedMDR.Wpf.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualización" Width="580" Height="460" MinWidth="480" MinHeight="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SubText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            <TextBlock Text="Novedades:" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        </StackPanel>
        <TextBox x:Name="NotesBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8" />
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Omitir esta versión" HorizontalAlignment="Left" Padding="14,7" Click="Skip_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Actualizar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="104" Padding="16,7" Click="Update_Click" />
                <Button Content="Más tarde" IsCancel="True" MinWidth="104" Padding="16,7" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
