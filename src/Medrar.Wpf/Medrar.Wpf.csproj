<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Medrar.Wpf</RootNamespace>
    <AssemblyName>Medrar.Wpf</AssemblyName>
    <Version>1.5.0</Version>
    <ApplicationIcon>..\Medrar\Resources\medrar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- El tema Fluent integrado de WPF (ThemeMode) aún está marcado como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Medrar\Resources\medrar.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medrar.Core\Medrar.Core.csproj" />
  </ItemGroup>

</Project>
