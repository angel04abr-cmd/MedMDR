<Window x:Class="Medrar.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Medrar.Wpf"
        Title="Medrar" Width="1060" Height="700" MinWidth="780" MinHeight="460"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menús -->
        <Menu Grid.Row="0" Background="Transparent" Padding="6,2">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Abrir _carpeta…" Click="OpenFolder_Click" />
                <MenuItem Header="_Subir un nivel" Click="Up_Click" InputGestureText="Retroceso" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Opciones">
                <MenuItem Header="_Tema">
                    <MenuItem x:Name="ThemeSystem" Header="Predeterminado del sistema" IsCheckable="True" Tag="System" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeLight" Header="Claro" IsCheckable="True" Tag="Light" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeDark" Header="Oscuro" IsCheckable="True" Tag="Dark" Click="Theme_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Ay_uda">
                <MenuItem Header="_Acerca de Medrar…" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Barra de comandos -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4,10,2">
            <local:CommandButton x:Name="CmdAdd" Kind="Add" Label="Añadir" Click="Command_Click" />
            <local:CommandButton x:Name="CmdExtract" Kind="Extract" Label="Extraer en" Click="Command_Click" />
            <local:CommandButton x:Name="CmdTest" Kind="Test" Label="Comprobar" Click="Command_Click" />
            <local:CommandButton x:Name="CmdView" Kind="View" Label="Ver" Click="Command_Click" />
            <local:CommandButton x:Name="CmdDelete" Kind="Delete" Label="Eliminar" Click="Command_Click" />
            <local:CommandButton x:Name="CmdFind" Kind="Find" Label="Buscar" Click="Command_Click" />
            <local:CommandButton x:Name="CmdWizard" Kind="Wizard" Label="Asistente" Click="Command_Click" />
            <local:CommandButton x:Name="CmdInfo" Kind="Info" Label="Información" Click="Command_Click" />
            <Rectangle Width="1" Margin="8,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <local:CommandButton x:Name="CmdRepair" Kind="Repair" Label="Reparar" Click="Command_Click" />
        </StackPanel>

        <!-- Barra de direcciones -->
        <Grid Grid.Row="2" Margin="12,6,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Grid.Column="0" Width="38" Height="34" Padding="0" Margin="0,0,8,0" ToolTip="Subir un nivel (Retroceso)" Click="Up_Click">
                <local:Icon Kind="Up" Size="18" />
            </Button>
            <TextBox x:Name="AddressBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="10,0" KeyDown="AddressBox_KeyDown" />
        </Grid>

        <!-- Lista de ficheros -->
        <Border Grid.Row="3" Margin="12,0,12,8" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListView x:Name="FileList" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource FileRowStyle}" Margin="2,4,2,4"
                      MouseDoubleClick="FileList_MouseDoubleClick" SelectionChanged="FileList_SelectionChanged"
                      GridViewColumnHeader.Click="Header_Click" SizeChanged="FileList_SizeChanged">
                <ListView.View>
                    <GridView x:Name="Columns" AllowsColumnReorder="False">
                        <GridViewColumn Header="Nombre" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="22" Height="22" Margin="2,0,10,0">
                                            <local:Icon Kind="{Binding VectorIcon, TargetNullValue=Info}" Size="22"
                                                        Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding ShellIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasShellIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tamaño" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Margin="0,0,14,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tipo" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Modificado" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Barra de estado -->
        <Grid Grid.Row="4" Margin="16,2,16,8">
            <TextBlock x:Name="StatusLeft" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
