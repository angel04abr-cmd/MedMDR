<Window x:Class="Medrar.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de MedMDR" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="32,28,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/Assets/app.ico" Width="88" Height="88" VerticalAlignment="Top" Margin="0,2,28,0"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock x:Name="NameText" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Margin="0,2,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock TextWrapping="Wrap" Text="Gestor de archivos comprimidos para Windows." />
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Crea y extrae .mdr, ZIP, 7Z, TAR y GZ; lee además RAR, BZ2, XZ y más." />
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="Todo el código, los iconos y los textos son propios." />
            <TextBlock TextWrapping="Wrap" Margin="0,16,0,0">
                <Run Text="Proyecto hecho por " /><Run x:Name="AuthorRun" FontWeight="SemiBold" /><Run Text=", autor del repositorio en GitHub." />
            </TextBlock>
            <TextBlock Margin="0,6,0,0">
                <Hyperlink x:Name="RepoLink" Click="RepoLink_Click" />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Licencia MIT. Lectura de RAR y 7Z con SharpCompress (licencia MIT)." />
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="1" Content="Cerrar" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="108" Margin="0,28,0,0" Padding="16,7" Click="Close_Click" />
    </Grid>
</Window>
