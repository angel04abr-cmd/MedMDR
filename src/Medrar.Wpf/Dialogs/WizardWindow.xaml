<Window x:Class="Medrar.Wpf.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Medrar.Wpf"
        Title="Asistente" Width="640" Height="540" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: paso actual y progreso -->
        <StackPanel Margin="32,24,32,0">
            <TextBlock x:Name="StepText" Style="{StaticResource Hint}" />
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
            <ProgressBar x:Name="StepBar" Minimum="0" Maximum="3" Height="4" Margin="0,14,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,10,32,0">
            <!-- Paso 1: qué hacer -->
            <StackPanel x:Name="Page0">
                <TextBlock Text="Elige la operación:" Style="{StaticResource FieldLabel}" />
                <RadioButton x:Name="OpCreate" GroupName="op" IsChecked="True" Margin="0,8,0,0" Padding="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Crear un archivo comprimido nuevo" FontWeight="SemiBold" />
                        <TextBlock Text="Elige ficheros o carpetas y guárdalos en un solo archivo." Style="{StaticResource Hint}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OpExtract" GroupName="op" Margin="0,16,0,0" Padding="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Extraer los ficheros de un archivo comprimido" FontWeight="SemiBold" />
                        <TextBlock Text="Abre un archivo y saca su contenido a una carpeta." Style="{StaticResource Hint}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Paso 2 (crear): qué comprimir -->
            <Grid x:Name="Page1Create" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Ficheros y carpetas que se incluirán:" Style="{StaticResource FieldLabel}" />
                <ListBox x:Name="SourcesList" Grid.Row="1" Margin="0,2,0,0" SelectionMode="Extended" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Añadir ficheros…" Padding="14,7" Click="AddFiles_Click" />
                    <Button Content="Añadir carpeta…" Padding="14,7" Margin="8,0,0,0" Click="AddFolder_Click" />
                    <Button Content="Quitar" Padding="14,7" Margin="8,0,0,0" Click="RemoveSource_Click" />
                </StackPanel>
            </Grid>

            <!-- Paso 2 (extraer): qué archivo -->
            <StackPanel x:Name="Page1Extract" Visibility="Collapsed">
                <TextBlock Text="Archivo que se va a extraer:" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ArchiveBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                    <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="BrowseArchive_Click" />
                </Grid>
            </StackPanel>

            <!-- Paso 3 (crear): opciones -->
            <StackPanel x:Name="Page2Create" Visibility="Collapsed">
                <TextBlock Text="Nombre del archivo (sin extensión):" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                <TextBlock Text="Carpeta donde se guardará:" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DestBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                    <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="BrowseDest_Click" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Formato:" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FormatBox" Height="32" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nivel de compresión:" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LevelBox" Height="32" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <CheckBox x:Name="PwCheck" Content="Proteger con contraseña" VerticalAlignment="Center" Checked="PwCheck_Changed" Unchecked="PwCheck_Changed" />
                    <Button x:Name="PwButton" Content="Contraseña…" Margin="14,0,0,0" Padding="14,6" Click="Password_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Paso 3 (extraer): destino -->
            <StackPanel x:Name="Page2Extract" Visibility="Collapsed">
                <TextBlock Text="Los ficheros se extraerán en:" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExtractDestBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" />
                    <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Padding="14,7" Click="BrowseExtractDest_Click" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="32,12,32,22">
            <Button x:Name="BackButton" Content="Atrás" HorizontalAlignment="Left" MinWidth="96" Padding="16,7" Click="Back_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextButton" Content="Siguiente" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="110" Padding="16,7" Click="Next_Click" />
                <Button Content="Cancelar" IsCancel="True" MinWidth="96" Padding="16,7" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
